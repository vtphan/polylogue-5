generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  runs             Run[]
  practiceAttempts PracticeAttempt[]

  @@map("students")
}

model CatalogEpisode {
  storyId           String           @map("story_id")
  episodeId         String           @map("episode_id")
  storyTitle        String           @map("story_title")
  episodeTitle      String           @map("episode_title")
  lessonPackagePath String           @map("lesson_package_path")
  transcriptPath    String           @map("transcript_path")
  isAvailable       Boolean          @default(true) @map("is_available")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  runs              Run[]

  @@id([storyId, episodeId])
  @@map("catalog_episodes")
}

model Run {
  runId              String         @id @default(cuid()) @map("run_id")
  studentId          String         @map("student_id")
  storyId            String         @map("story_id")
  episodeId          String         @map("episode_id")
  currentSceneIndex  Int            @default(0) @map("current_scene_index")
  sceneHighWaterMark Int            @default(0) @map("scene_high_water_mark")
  starsEarned        Int            @default(0) @map("stars_earned")
  readingFinishedAt  DateTime?      @map("reading_finished_at")
  bonusEarnedAt      DateTime?      @map("bonus_earned_at")
  startedAt          DateTime       @default(now()) @map("started_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  student            Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  catalogEpisode     CatalogEpisode @relation(fields: [storyId, episodeId], references: [storyId, episodeId], onDelete: Cascade)
  quizAttempts       QuizAttempt[]

  @@unique([studentId, storyId, episodeId], name: "unique_student_episode_run")
  @@index([studentId])
  @@index([storyId, episodeId])
  @@map("runs")
}

model PracticeAttempt {
  id          String    @id @default(cuid())
  studentId   String    @map("student_id")
  flawId      String    @map("flaw_id")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, flawId], name: "unique_student_practice_flaw")
  @@index([studentId])
  @@map("practice_attempts")
}

model QuizAttempt {
  id                  String    @id @default(cuid())
  runId               String    @map("run_id")
  levelId             String    @map("level_id")
  turnId              String    @map("turn_id")
  firstOptionId       String?   @map("first_option_id")
  finalOptionId       String?   @map("final_option_id")
  usedHint            Boolean   @default(false) @map("used_hint")
  starsEarned         Int       @default(0) @map("stars_earned")
  lockedAt            DateTime? @map("locked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  run                 Run       @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, levelId], name: "unique_run_level_quiz_attempt")
  @@index([runId])
  @@map("quiz_attempts")
}
